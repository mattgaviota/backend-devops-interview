# DO NOT commit real values. This file is a template only.
#
# Create the Secret in the cluster with:
#   kubectl create secret generic backend-devops-interview \
#     --from-literal=SECRET_KEY="$(openssl rand -base64 50)" \
#     --from-literal=DATABASE_PASSWORD="<cloud-sql-password>"
#
# Or manage it with your secrets operator of choice (External Secrets, Sealed Secrets, etc.).
apiVersion: v1
kind: Secret
metadata:
  name: backend-devops-interview
  namespace: default
type: Opaque
stringData:
  SECRET_KEY: "replace-with-a-strong-random-key"
  DATABASE_PASSWORD: "replace-with-cloud-sql-password"
